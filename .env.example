# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
#
# La anon key es pública y va al navegador: es correcto y esperado. Lo que
# protege los datos son las políticas RLS de supabase/migrations/0002_rls.sql,
# no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ La service_role key OMITE la RLS por completo. Solo servidor, nunca con
# prefijo NEXT_PUBLIC_, nunca en el repositorio. Si se filtra, cualquiera puede
# leer los vouchers, teléfonos y DNI de todos los clientes.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio. En producción, el dominio real (lo usan los links de
# seguimiento y las URLs de retorno de la pasarela).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Yape manual
# ─────────────────────────────────────────────────────────────────────────────
# Número y titular que se le muestran al cliente para que yapee.
YAPE_NUMERO=
YAPE_TITULAR=

# ─────────────────────────────────────────────────────────────────────────────
# Tupay (pasarela automática) — OPCIONAL
# ─────────────────────────────────────────────────────────────────────────────
# Con PAYMENTS_TUPAY_ENABLED=false la tienda funciona solo con Yape manual.
#
# ⚠️ Tupay exige whitelisting de la IP de salida. Vercel y cualquier serverless
# salen por IPs dinámicas, así que fallaría de forma intermitente (error 202
# INVALID_IP): funciona en pruebas y falla a ratos en producción. Requiere un
# host con IP fija (Fly.io, Railway) o un NAT de salida estático.
PAYMENTS_TUPAY_ENABLED=false
TUPAY_API_KEY=
TUPAY_API_SECRET=
TUPAY_BASE_URL=https://api-stg.tupayonline.com
TUPAY_TEST_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# Shalom (tracking de envíos a provincia) — OPCIONAL
# ─────────────────────────────────────────────────────────────────────────────
# Con SHALOM_ENABLED=false el seguimiento es manual: el admin pega la guía y la
# clave de retiro, y el cliente las ve en su página de seguimiento.
#
# ⚠️ Es un wrapper NO OFICIAL de terceros y pide el email y la contraseña de la
# cuenta de Shalom Pro del comerciante. No hay sandbox: cada guía emitida es un
# cargo real.
SHALOM_ENABLED=false
SHALOM_API_KEY=
SHALOM_PRO_EMAIL=
SHALOM_PRO_PASSWORD=
SHALOM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Cron del outbox
# ─────────────────────────────────────────────────────────────────────────────
# Protege /api/cron/outbox, que dispara el envío de los avisos encolados. Sin
# secreto, cualquiera podría invocarlo en bucle. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# En Vercel, además de definir esta variable, el cron de vercel.json la envía
# automáticamente como Bearer. En producción la ruta se NIEGA a funcionar si falta.
CRON_SECRET=
